#!/bin/zsh
# Opens Game Translator. Uses the folder that contains this app.
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$DIR" || exit 1
export PATH="$HOME/.pyenv/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
PY="$DIR/.venv/bin/python"
if [[ ! -f "$DIR/game_translator.py" || ! -x "$PY" ]]; then
  osascript -e 'display alert "Game Translator is not set up yet" message "Open Terminal in the game_translator folder and run:  ./setup.sh" as warning' >/dev/null
  exit 1
fi
LOG="$DIR/app.log"
echo "---- $(date) ----" >> "$LOG"
exec "$PY" game_translator.py "$@" >> "$LOG" 2>&1
